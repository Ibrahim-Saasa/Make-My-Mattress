# Supabase SMS Webhook function env example
SUPABASE_SMS_SECRET=your-supabase-webhook-secret
SMS_PROVIDER=fast2sms

# Fast2SMS (example)
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_ENDPOINT=https://www.fast2sms.com/dev/bulkV2

# Gupshup (example)
GUPSHUP_APP_ID=your-gupshup-app-id
GUPSHUP_APP_SECRET=your-gupshup-app-secret
GUPSHUP_ENDPOINT=https://api.gupshup.io/sm/api/v1/msg
